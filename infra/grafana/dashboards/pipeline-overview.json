{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "tags": ["convintel"],
  "timezone": "browser",
  "title": "Pipeline overview",
  "uid": "convintel-pipeline-overview",
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Operator latency p50 / p95",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 8 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, operator) (rate(convintel_operator_latency_seconds_bucket[5m])))",
          "legendFormat": "p50 {{operator}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, operator) (rate(convintel_operator_latency_seconds_bucket[5m])))",
          "legendFormat": "p95 {{operator}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Pipeline latency p50 / p95",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 8 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, channel) (rate(convintel_pipeline_latency_seconds_bucket[5m])))",
          "legendFormat": "p50 {{channel}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, channel) (rate(convintel_pipeline_latency_seconds_bucket[5m])))",
          "legendFormat": "p95 {{channel}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Operator error rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 8 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operator, error_type) (rate(convintel_operator_errors_total[5m]))",
          "legendFormat": "{{operator}} {{error_type}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Requests rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 8 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route, status) (rate(convintel_requests_total[5m]))",
          "legendFormat": "{{route}} {{status}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "LLM tokens",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 8 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (direction) (rate(convintel_llm_tokens_total[5m]))",
          "legendFormat": "{{direction}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "LLM cost / conversation (1h)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "decimals": 5, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.005 }] } },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(convintel_llm_cost_usd_total[1h])) / sum(increase(convintel_requests_total[1h]))"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Intent verifier invocations",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 8 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(convintel_intent_verifier_invocations_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "ASR real-time factor p95",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": { "unit": "none", "custom": { "drawStyle": "line", "fillOpacity": 8 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(convintel_asr_realtime_factor_bucket[5m])))",
          "legendFormat": "p95 {{model}}"
        }
      ]
    }
  ]
}
