# Copy to .env and fill in what you need. Never commit .env.
# Every variable maps to a field of convintel.config.Settings.

# --- LLM ------------------------------------------------------------------
# Provider used by convintel.llm.client: anthropic | ollama | google | openai
LLM_PROVIDER=anthropic
# Model id for the chosen provider (e.g. claude-haiku-4-5, llama3.1:8b, gemini-2.5-flash, gpt-4.1-mini)
LLM_MODEL=claude-haiku-4-5
# Anthropic API key (required when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# Google Gemini API key (required when LLM_PROVIDER=google)
GOOGLE_API_KEY=
# OpenAI API key (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=
# Ollama server for local models on the GPU (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# --- Observability and registries ----------------------------------------
# Arize Phoenix OTLP collector endpoint (traces)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# MLflow tracking server (model and prompt registry)
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Storage --------------------------------------------------------------
# Postgres connection URL for stored insights (add user:password@ locally)
DATABASE_URL=postgresql://localhost:5432/convintel

# --- Twilio ---------------------------------------------------------------
# Account SID from the Twilio console (starts with AC)
TWILIO_ACCOUNT_SID=
# Auth token, also used to validate webhook signatures
TWILIO_AUTH_TOKEN=
# Twilio phone number in E.164 format (e.g. +15550001111)
TWILIO_PHONE_NUMBER=

# --- Pipeline -------------------------------------------------------------
# Override the intent classifier's threshold (0-1). Below it, the LLM verifier checks the intent.
# Leave empty to use the threshold stored in the model bundle.
INTENT_VERIFIER_THRESHOLD=
